.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers and linters
.mypy_cache/
.pyre/
.ruff_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment variables
.env
.env.*

# Secrets / API keys
datos/APkey
**/APkey
*.key

# Large / raw data (not para git; se regenera o se descarga en local
# ejecutando notebooks/00_descarga_datos.ipynb)
#
# `datos/` puede ser un enlace simbolico a un almacen fuera del repo (los
# .npz del backfill son de GB). Nada de ahi se versiona: se regenera.
/datos/*
datos/*.zip
datos/*.duckdb
datos/extracted/
datos/raw/
!/datos/interim/
!/datos/interim/**
datos/interim/*.parquet
datos/interim/*.npy
datos/interim/*.npz
datos/interim/*.pkl
datos/interim/**/*.parquet
datos/interim/**/*.npy
datos/interim/**/*.npz
datos/interim/**/*.pkl
*.duckdb

# reports/figures/ y reports/tables/ SI se versionan: son la evidencia de
# que el codigo genera las graficas/tablas que pide el enunciado.

# IDEs and editors
.vscode/
.idea/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes


# Logs de stdout de la busqueda de hiperparametros (solo trazas de proceso;
